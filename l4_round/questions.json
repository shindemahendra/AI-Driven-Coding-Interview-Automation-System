    {
        "title": "Implement a Queue using List",
        "description": "Implement a Queue data structure using a Python list. Implement enqueue (add to the end), dequeue (remove from the front), peek (return the front element), and is_empty methods.",
        "difficulty": "MEDIUM",
        "public_tests": [
            {
                "input": "enqueue(1), enqueue(2), dequeue(), peek()",
                "expected": "2"
            },
            {
                "input": "is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(5), is_empty()",
                "expected": "False"
            }
        ],
        "hidden_tests": [
            {
                "input": "enqueue(1), enqueue(2), enqueue(3), dequeue(), dequeue(), peek()",
                "expected": "3"
            },
            {
                "input": "enqueue(10), enqueue(20), enqueue(30), dequeue(), enqueue(40), dequeue(), peek()",
                "expected": "30"
            },
            {
                "input": "enqueue(1), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(5), enqueue(6), enqueue(7), dequeue(), enqueue(8), enqueue(9), dequeue(), dequeue(), peek()",
                "expected": "8"
            },
            {
                "input": "enqueue(1), enqueue(1), enqueue(1), dequeue(), dequeue(), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(1), enqueue(2), enqueue(3), enqueue(4), dequeue(), dequeue(), dequeue(), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(1), peek(), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(5), dequeue(), enqueue(10), peek()",
                "expected": "10"
            },
            {
                "input": "enqueue(15), dequeue(), enqueue(20), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "is_empty(), enqueue(5), is_empty(), dequeue(), is_empty()",
                "expected": "True"
            },
            {
                "input": "enqueue(-1), peek()",
                "expected": "-1"
            },
            {
                "input": "enqueue(0), peek()",
                "expected": "0"
            },
            {
                "input": "enqueue(1000), peek()",
                "expected": "1000"
            },
            {
                "input": "enqueue(-100), peek()",
                "expected": "-100"
            },
            {
                "input": "enqueue(1), enqueue(2), enqueue(3), dequeue(), peek()",
                "expected": "2"
            }
        ]
    },
